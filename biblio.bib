@article{Brostow,
	title = {Pressure second virial coefficients of hydrocarbons, fluorocarbons, and their mixtures: {Interactions} of walks},
	volume = {71},
	issn = {0021-9606, 1089-7690},
	shorttitle = {Pressure second virial coefficients of hydrocarbons, fluorocarbons, and their mixtures},
	url = {https://pubs.aip.org/jcp/article/71/6/2716/443279/Pressure-second-virial-coefficients-of},
	doi = {10.1063/1.438630},
	abstract = {Molecules of some hydrocarbons and fluorocarbons have been represented by graphs, and walks on graphs considered. The walk interaction formalism developed previously for liquid state properties has been applied to gas pressure second virial coefficients of n-alkanes, n-perfluorocarbons, and alk-1-enes. Agreement between experiment and calculation within limits of the experimental accuracy has been obtained. For each class of compounds properties of the respective binary mixtures have been predicted in terms of properties of pure compounds, without the use of any combining rules; again satisfactory agreement with available experimental data has been found.},
	language = {en},
	number = {6},
	urldate = {2026-10-06},
